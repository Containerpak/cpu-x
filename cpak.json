{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "CPU-X",
  "description": "Inspect processor, motherboard, memory and system information.",
  "version": "5.4.0",
  "image": "ghcr.io/containerpak/cpu-x@sha256:eee1f6fcaf7d2a3b403722e5d3685ea849f7d96f816af70e4f545cff7ed736fb",
  "binaries": [
    "/usr/bin/cpu-x"
  ],
  "desktop_entries": [
    "/usr/share/applications/io.github.thetumultuousunicornofdarkness.cpu-x.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "/sys",
        "access": "read-only"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
